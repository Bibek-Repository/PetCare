<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Scrollable Home Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Greeting -->
            <TextView
                android:id="@+id/greetingTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hi, User! 👋"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Welcome back to PetCare"
                android:textSize="16sp" />

            <!-- My Pets -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="My Pets"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Horizontal Pets -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homePetsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/noHomePetsTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                android:background="#F5F5F5"
                android:text="🐾 You haven't added any pets yet."
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- Tasks -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Tasks"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Horizontal Tasks -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeTasksRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/noHomeTasksTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                android:background="#F5F5F5"
                android:text="✓ No tasks yet."
                android:textSize="16sp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/bottom_navigation" />

</LinearLayout>